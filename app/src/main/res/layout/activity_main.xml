<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#333333"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvStatusHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● SYSTEM LOCKED"
                android:textColor="#FF5252"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="14dp"/>
        </com.google.android.material.card.MaterialCardView>

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Google Cloud API Key (AIzaSy...)"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:background="#1E1E1E"
            android:padding="14dp"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="UNLOCK CONSOLE"
            android:textStyle="bold"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paste Review URLs (1per line,Up to 50 links):"
            android:textColor="#616060"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etReviewUrls"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:hint="https://maps.app.goo.gl/...\nhttps://maps.app.goo.gl/..."
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:textColor="#FFFFFF"
            android:textColorHint="#444444"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:enabled="false"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnSubmitReport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="START BULK AUTO-REPORT"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:enabled="false"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvTerminalLog"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#000000"
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:text="> Terminal ready..."
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="VIEW REPORT HISTORY &amp; STATUS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#333333"/>

    </LinearLayout>
</ScrollView>