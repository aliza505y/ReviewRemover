<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#0C0F12"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SERVER DB REVIEW REMOVER"
        android:textColor="#00FF66"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etBaseUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Client Base URL (e.g. https://api.mysite.com)"
        android:textColorHint="#667085"
        android:textColor="#FFFFFF"
        android:background="#161B22"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Admin API Key / Auth Token"
        android:textColorHint="#667085"
        android:textColor="#FFFFFF"
        android:inputType="textPassword"
        android:background="#161B22"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnStartCleaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RUN LIVE DATABASE CLEANUP"
        android:backgroundTint="#00FF66"
        android:textColor="#000000"
        android:textStyle="bold"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"/>

    <TextView
        android:id="@+id/tvLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#050709"
        android:padding="10dp"
        android:textColor="#00FF66"
        android:fontFamily="monospace"
        android:text=">> Console initialized. Enter server API details above to execute database cleanup..."
        android:textSize="12sp"/>


</LinearLayout>



